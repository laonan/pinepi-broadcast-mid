{
  "producers": {
    "REPLACE_WITH_PRODUCER_TOKEN": {
      "targets": "*"
    },
    "REPLACE_WITH_PRODUCER_SPEAKER_TOKEN": {
      "targets": ["speaker"]
    },
    "REPLACE_WITH_PRODUCER_EPAPER_TOKEN": {
      "targets": ["epaper"]
    }
  },
  "devices": {
    "speaker": {
      "token": "REPLACE_WITH_PRODUCER_SPEAKER_TOKEN"
    },
    "epaper": {
      "token": "REPLACE_WITH_PRODUCER_EPAPER_TOKEN"
    }
  }
}
